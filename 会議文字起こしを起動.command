#!/bin/bash
# 会議 話者別文字起こし — ワンクリック起動用
# Finder でこのファイルをダブルクリックすると、GUI がブラウザで開きます。

# このスクリプトが置かれている場所を、プロジェクトの基準ディレクトリにする。
# （どこから起動されても正しく動くようにするため）
cd "$(dirname "$0")" || exit 1

echo "=========================================="
echo "  会議 話者別文字起こし を起動します"
echo "=========================================="
echo

# 仮想環境の存在チェック
if [ ! -f ".venv/bin/python" ]; then
    echo "エラー: 仮想環境 (.venv) が見つかりません。"
    echo "セットアップが済んでいない可能性があります。README.md を確認してください。"
    echo
    echo "このウィンドウは閉じて構いません。"
    exit 1
fi

echo "起動中… 数秒後にブラウザが自動で開きます。"
echo "（開かない場合は http://127.0.0.1:7860 を手動で開いてください）"
echo
echo "■ 終了するには、このウィンドウで Control + C を押してください。"
echo "------------------------------------------"
echo

# 仮想環境の Python で GUI を起動
.venv/bin/python src/app.py

# ここに到達するのは終了後（正常終了・エラー終了どちらも）
echo
echo "------------------------------------------"
echo "終了しました。このウィンドウは閉じて構いません。"
